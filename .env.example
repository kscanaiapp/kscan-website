# K Scan Website - Required Environment Variables

# Public room preview / Dressing Room share links
# Points to the Supabase project used by the current mobile tester app.
# ROOMS_SUPABASE_* is for public Dressing Room previews.
# Do not point room preview at WAITLIST_PRIVACY_*.
ROOMS_SUPABASE_URL=https://wyyuqfdxucjksghsmhry.supabase.co
ROOMS_SUPABASE_SERVICE_ROLE_KEY=your_app_staging_service_role_key

# Waitlist/privacy database only
# WAITLIST_PRIVACY_* is for waitlist/privacy only.
# Do not point waitlist at ROOMS_SUPABASE_*.
WAITLIST_PRIVACY_SUPABASE_URL=https://yzqjvdfgefveprobvvyw.supabase.co
WAITLIST_PRIVACY_SUPABASE_SERVICE_ROLE_KEY=your_waitlist_privacy_service_role_key

# Email provider (Resend)
RESEND_API_KEY=<resend-api-key>

# Owner/admin notification for new waitlist signups
WAITLIST_ALERT_EMAIL=owner@example.com

# Legacy fallback vars, deprecated if still present
SUPABASE_URL=<legacy-url>
SUPABASE_SERVICE_ROLE_KEY=<legacy-service-role-key>
