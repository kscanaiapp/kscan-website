# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude
.claude/settings.local.json
.claude/
/.claude/**

# internal investor docs utility
investor-docs/input/*.pdf
investor-docs/output/*.pdf
investor-docs/investors.csv
investor-docs/watermark_log.csv
!investor-docs/input/.gitkeep
!investor-docs/output/.gitkeep
!investor-docs/investors.example.csv

# private runtime-only materials
private/investor-docs/

# Word temp/lock files that should never be committed
public/docs/~$*
public/docs/~WRL*.tmp

# Demo backup archives (serve from public/demo/ only)
public/demo-backups/

# Internal validation docs (not for public serving)
public/docs/beta-v2-validation-summary.md
public/docs/kscan-apple-privacy-policy.docx

# Local QA and Test Logging Noise
*.log
*.err
qa/
.codex-screens/
supabase/.temp/

# Claude local settings
.claude/settings.local.json

.env
.env.local
.env.production
.env.*
!.env.example
